# Root environment configuration template for MemoAI
# Copy to .env or use respective frontend/.env and backend/.env

# Backend Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Database Configuration (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=memoai

# JWT Authentication
JWT_SECRET=super-secret-memoai-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api

# AI Service Configuration (Provider agnostic)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
