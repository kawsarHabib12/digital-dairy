            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunset at Cox's Bazar Beach\",\n  \"content\": \"Walked along the longest unbroken natural beach. The sea breeze was therapeutic and sunset was mesmerizing with warm orange hues.\",\n  \"memoryDate\": \"2026-10-09\",\n  \"mood\": \"Happy\",\n  \"categoryName\": \"Travel\",\n  \"tags\": [\"beach\", \"sunset\", \"vacation\"],\n  \"locationName\": \"Cox's Bazar Beach, Bangladesh\",\n  \"latitude\": 21.4272,\n  \"longitude\": 91.9702,\n  \"imageUrls\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/memories",
              "host": ["{{baseUrl}}"],
              "path": ["memories"]
            }
          }
        },
        {
          "name": "List User Memories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/memories?mood=Happy&search=Cox",
              "host": ["{{baseUrl}}"],
              "path": ["memories"],
              "query": [
                { "key": "mood", "value": "Happy" },
                { "key": "search", "value": "Cox" }
              ]
            }
          }
        },
        {
          "name": "Get Memory By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/memories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["memories", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
